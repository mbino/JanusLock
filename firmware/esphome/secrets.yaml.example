# Copy to secrets.yaml (gitignored) and fill in your own values.
wifi_ssid: "your-2.4GHz-ssid"
wifi_password: "your-wifi-password"

# From GET /api/v1/user/profile — the tokenRaw of the token with tokenId == 1.
janus_master_token: "0011223344556677889900aabbccddeeff00"

# Your lock's BLE address (seen in an ESPHome/ nRF Connect scan; advertises name "Sma..."
# with Nordic manufacturer data containing your serial prefix).
lock_mac: "AA:BB:CC:DD:EE:FF"
